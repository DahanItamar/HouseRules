max-line-length: 100
max-public-methods: 30
disable:
  - class-definitions-order
  - max-returns
  # The floor controller, the cabinet panel and the poker table are deliberately
  # one file each: they are single cohesive classes whose parts are only ever
  # used together, and splitting them for a line count would scatter one screen's
  # behaviour across several files. test_ui covers the whole shell, so it carries
  # more test methods than the rule allows. Both limits are waived rather than
  # met by moving code around; if any of these grows a genuinely separable part,
  # split it on that seam instead of to satisfy a number.
  - max-file-lines
  - max-public-methods
